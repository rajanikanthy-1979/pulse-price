# =============================================================================
# PulsePrice - Git Attributes Configuration
# https://git-scm.com/docs/gitattributes
# =============================================================================

# Auto-detect text files and normalize line endings to LF on commit
* text=auto

# -----------------------------------------------------------------------------
# Shell Scripts & Executables (always LF)
# -----------------------------------------------------------------------------
/gradlew                text eol=lf
*.sh                    text eol=lf

# -----------------------------------------------------------------------------
# Windows Batch & Command Scripts (always CRLF)
# -----------------------------------------------------------------------------
*.bat                   text eol=crlf
*.cmd                   text eol=crlf

# -----------------------------------------------------------------------------
# Source Code (LF)
# -----------------------------------------------------------------------------
*.kt                    text eol=lf
*.kts                   text eol=lf
*.java                  text eol=lf
*.sql                   text eol=lf
*.lua                   text eol=lf

# -----------------------------------------------------------------------------
# Configuration, Markup & Documentation (LF)
# -----------------------------------------------------------------------------
*.yml                   text eol=lf
*.yaml                  text eol=lf
*.json                  text eol=lf
*.xml                   text eol=lf
*.properties            text eol=lf
*.md                    text eol=lf
*.txt                   text eol=lf
.editorconfig           text eol=lf
.gitignore              text eol=lf
.gitattributes          text eol=lf

# -----------------------------------------------------------------------------
# Binary Files
# -----------------------------------------------------------------------------
*.jar                   binary
*.zip                   binary
*.tar.gz                binary
*.png                   binary
*.jpg                   binary
*.jpeg                  binary
*.ico                   binary
*.svg                   text
